1137. N-th Tribonacci Number


class Solution:
	def tribonacci(self, n: int) -> int:
		t_0 = 0
		t_1 = 1
		t_2 = 1

		if n == 0:
			return 0
		elif n == 1 or n == 2:
			return 1
		
		i = 3
		while True:
			t_i = t_0 + t_1 + t_2
			if i == n:
				return t_i

			t_0 = t_1
			t_1 = t_2
			t_2 = t_i
			
			i += 1
			
		