class Solution:
	def levelOrder(self, root: TreeNode | None) -> list[list[int]]:
		if not root:
			return []

		queue = deque()
		queue.append(root)
		res = []

		while queue:
			cur_level_size = len(queue)
			sub_res = []
			for i in range(cur_level_size):
				node = queue.popleft()
				sub_res.append(node.val)
				if node.left:
					queue.append(node.left)
				if node.right:
					queue.append(node.right)
			res.append(sub_res)

		return res



# 递归解法

class Solution:
	def levelOrder(self, root: TreeNode) -> List[List[int]]:
		node = root
		res = []

		def iterator(node_p, level):
			if len(res) == level:   # level is the index, so it starts from zero; Add a new sub-list depends on level
				res.append([])

			res[level].append(node_p.val)

			if node_p.left:
				iterator(node_p.left, level+1)
			if node_p.right:
				iterator(node_p.right, level+1)

		if not node:
			return res

		iterator(node, level = 0)
		return res

