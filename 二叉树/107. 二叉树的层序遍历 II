107. 二叉树的层序遍历 II

# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right


class Solution:
	def levelOrderBottom(self, root: TreeNode | None) -> list[list[int]]:
		if not root: return []
		res_helper = deque()
		queue = deque([root])

		while queue:
			sub_res = []
			for _ in range(len(queue)):
				node = queue.popleft()
				sub_res.append(node.val)
				if node.left:
					queue.append(node.left)
				if node.right:
					queue.append(node.right)

			res_helper.appendleft(sub_res)
		
		return list(res_helper)


